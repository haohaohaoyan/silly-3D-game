script/source = "extends Node3D

# builtins for level design

func _ready() -> void:
	$SlideTooltip.area_entered.connect(Global.tooltip.bind(\"Hold SHIFT to slide\")) # why signal why

func _physics_process(_delta: float) -> void:
	if Global.player_pos.x >= -50:
		$Rain.global_position = Global.player_pos + Vector3(0,16,0)
"

